<html lang="{{@site.locale}}">
    <head>

        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        {{! Apply the stored color scheme before first paint to avoid flashing }}
        <script>
            (function () {
                var theme = localStorage.getItem("theme");
                if (theme === "light" || theme === "dark") {
                    document.documentElement.setAttribute("data-theme", theme);
                }
            })();
        </script>

        <link
            rel="preload"
            href="{{asset 'fonts/bricolage-grotesque-800.woff2'}}"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link
            rel="preload"
            href="{{asset 'fonts/figtree-400.woff2'}}"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <link rel="stylesheet" href="{{asset 'built/index.css'}}" />
        <script src="{{asset 'built/index.js'}}" defer></script>

        <title>{{meta_title}}</title>

        {{ghost_head}}
        {{! Outputs important meta data and settings, should always be in <head> }}

    </head>
    <body class="{{body_class}}">
        <div class="gh-viewport">

            <header id="gh-head" class="gh-head">
                <nav class="gh-head-inner gh-container">

                    {{! The front page names its author here, since the hero
                        below shows a face and a claim but not a name. Every
                        other page needs a way back instead. }}
                    <div class="gh-head-start">
                        {{#is "home"}}
                            <span class="gh-head-name">{{@site.title}}</span>
                        {{else}}
                            <a class="gh-head-home" href="{{@site.url}}">Home</a>
                        {{/is}}
                    </div>
                    <div class="gh-head-brand">
                        {{^is "home"}}
                            <a class="gh-head-logo" href="{{@site.url}}">
                                {{#if @site.logo}}
                                    <img
                                        src="{{@site.logo}}"
                                        alt="{{@site.title}}"
                                    />
                                {{else}}
                                    {{@site.title}}
                                {{/if}}
                            </a>
                        {{/is}}
                    </div>
                    <div class="gh-head-actions">
                        <div class="gh-head-actions-list">
                            {{search}}
                            <button
                                class="gh-theme-toggle"
                                aria-label="Toggle color scheme"
                            >
                                <span class="gh-theme-toggle-dark" aria-hidden="true">☾</span>
                                <span class="gh-theme-toggle-light" aria-hidden="true">☀</span>
                            </button>
                            {{#if @site.members_enabled}}
                                {{#if @member}}
                                    <a
                                        class="gh-button"
                                        href="#/portal/account"
                                    >Account</a>
                                {{else}}
                                    <a
                                        class="gh-button"
                                        href="{{@site.signup_url}}"
                                    >Subscribe</a>
                                {{/if}}
                            {{/if}}
                        </div>
                    </div>
                </nav>
            </header>

            <main class="gh-main">

                {{{body}}}
                {{! All content gets inserted here, index.hbs, post.hbs, etc }}

            </main>

            <footer class="gh-foot">
                <div class="gh-container">
                    <div class="gh-foot-menu">
                        {{navigation type="secondary"}}
                    </div>
                    <div class="gh-foot-meta">
                        &copy; {{date format="YYYY"}} {{@site.title}}
                        <span class="gh-foot-sep">&middot;</span>
                        <a href="{{@site.url}}/rss/">RSS</a>
                    </div>
                </div>
            </footer>

        </div>

        {{! <foot> }}
        {{ghost_foot}}
        {{! Outputs important scripts - should always be included before closing body tag }}

    </body>
</html>
